# En-tête générique d'une entité (course, édition, étape, équipe)
SELECT ?label ?desc ?img ?logo ?inception ?dissolved ?iso ?title ?parent ?parentLabel ?fromLabel ?toLabel ?start ?end ?km ?speed WHERE {
  BIND(wd:{{ID}} AS ?x)
  OPTIONAL { ?x rdfs:label ?label FILTER(LANG(?label) = "fr") }
  OPTIONAL { ?x schema:description ?desc FILTER(LANG(?desc) = "fr") }
  OPTIONAL { ?x wdt:P18 ?img }
  OPTIONAL { ?x wdt:P154 ?logo }
  OPTIONAL { ?x wdt:P571 ?inception }
  OPTIONAL { ?x wdt:P576 ?dissolved }
  OPTIONAL { ?x wdt:P17/wdt:P297 ?iso }
  OPTIONAL { ?a schema:about ?x; schema:isPartOf <https://fr.wikipedia.org/>; schema:name ?title }
  OPTIONAL { ?x wdt:P31|wdt:P361|wdt:P5138 ?parent. ?parent wdt:P641 wd:Q3609 }
  OPTIONAL { ?x wdt:P1427 ?from }
  OPTIONAL { ?x wdt:P1444 ?to }
  OPTIONAL { ?x wdt:P580|wdt:P585 ?start }
  OPTIONAL { ?x wdt:P582 ?end }
  OPTIONAL { ?x p:P3157/psn:P3157/wikibase:quantityAmount ?km }
  OPTIONAL { ?x p:P2052/psn:P2052/wikibase:quantityAmount ?speed }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "fr,en,mul,it,es,nl,de,pt". ?parent rdfs:label ?parentLabel. ?from rdfs:label ?fromLabel. ?to rdfs:label ?toLabel. ?x rdfs:label ?xLabel. }
} LIMIT 1
