# Les plus longues étapes de l'histoire de la course
SELECT ?st ?stLabel ?km ?fromLabel ?toLabel ?date WHERE {
  ?ed wdt:P31 wd:{{ID}}; wdt:P527 ?st.
  ?st p:P3157/psn:P3157/wikibase:quantityAmount ?km.
  OPTIONAL { ?st wdt:P1427 ?from } OPTIONAL { ?st wdt:P1444 ?to } OPTIONAL { ?st wdt:P585 ?date }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "fr,en,mul,it,es,nl,de,pt". }
} ORDER BY DESC(?km) LIMIT 10
